{
  "name": "situation-room-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:frontend": "node scripts/build_frontend.mjs",
    "monitor:core": "node analysis/monitor/run_core_sentinel.mjs",
    "monitor:all": "node analysis/monitor/run_full_audit.mjs",
    "monitor:docs": "node analysis/monitor/run_doc_watch.mjs",
    "monitor:report": "node analysis/monitor/report_latest.mjs",
    "test": "node scripts/verify_feeds_sync.mjs && node --test scripts/test/feeds.spec.mjs scripts/test/monitor.spec.mjs scripts/test/opensky-proxy.spec.mjs scripts/test/mcp-proxy.spec.mjs scripts/test/proxy-dependencies.spec.mjs scripts/test/root-dependencies.spec.mjs",
    "test:feeds-sync": "node scripts/verify_feeds_sync.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1"
  }
}
