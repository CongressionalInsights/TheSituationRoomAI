{
  "name": "situation-room-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:frontend": "node scripts/build_frontend.mjs",
    "monitor:core": "node analysis/monitor/run_core_sentinel.mjs",
    "monitor:all": "node analysis/monitor/run_full_audit.mjs",
    "monitor:docs": "node analysis/monitor/run_doc_watch.mjs",
    "monitor:report": "node analysis/monitor/report_latest.mjs",
    "test": "node scripts/verify_feeds_sync.mjs && node --test scripts/test/feeds.spec.mjs scripts/test/monitor.spec.mjs scripts/test/opensky-proxy.spec.mjs scripts/test/mcp-proxy.spec.mjs scripts/test/proxy-dependencies.spec.mjs scripts/test/root-dependencies.spec.mjs scripts/test/runtime.spec.mjs scripts/test/state-connector.spec.mjs scripts/test/acled-pagination.spec.mjs",
    "test:feeds-sync": "node scripts/verify_feeds_sync.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.11.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.14",
    "express-rate-limit": "8.7.1",
    "ip-address": "10.7.5",
    "fast-uri": "3.1.9",
    "qs": "6.17.0",
    "path-to-regexp": "8.4.2"
  }
}
